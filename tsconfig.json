{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@": ["src"],
      "@components": ["src/components"],
      "@components/atoms": ["src/components/atoms"],
      "@components/molecules": ["src/components/molecules"],
      "@components/compounds": ["src/components/compounds"],
      "@components/pages": ["src/components/pages"],
      "@assets": ["src/assets"],
      "@utils": ["src/utils"],
      "@types": ["src/types"],
      "@store": ["src/store"],
      "@hooks": ["src/hooks"],
      "@services": ["src/services"],
      "@routes": ["src/routes"],
      "@constants": ["src/constants"],
      "@configurations": ["src/configurations"]
    }
  },
  "include": ["src"]
}
